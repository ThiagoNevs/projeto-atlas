# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
FINDING_REVIEW_CASES_ENABLED=false

# OIDC da API (o issuer local abaixo é exclusivamente para desenvolvimento/testes)
AUTH_ISSUER=http://localhost:3199
AUTH_AUDIENCE=http://localhost:3001
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_CLOCK_TOLERANCE_SECONDS=60
AUTH_SERVICE_TOKEN_MAX_LIFETIME_SECONDS=300
AUTH_JWKS_URI=http://localhost:3199/jwks
AUTH_HUMAN_CLIENT_ID=atlas-web
AUTH_SERVICE_ACTORS_JSON=[]
AUTH_ROLE_CLAIM=groups
AUTH_ATLAS_ACCESS_VALUES=atlas-user
AUTH_VIEWER_ROLE_VALUES=atlas-viewer
AUTH_ANALYST_ROLE_VALUES=atlas-analyst
AUTH_ADMIN_ROLE_VALUES=atlas-admin

# PostgreSQL
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5432/atlas
